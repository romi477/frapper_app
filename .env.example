FRAPPER_USERNAME=<..>
FRAPPER_PASSWORD=<..>

REDIS_HOST=redis
REDIS_PORT=6379

# Internal Docker DNS name of the API service (not a URL).
FRAPPER_API_HOST=api

# One port: uvicorn, bot/listener clients, and localhost publish
# (127.0.0.1:<port> for host Nginx). Do not bind this to 0.0.0.0.
# Required by Compose (${FRAPPER_API_PORT:?}).
FRAPPER_API_PORT=4040

# Swagger / Redoc / OpenAPI (same Basic Auth as /web). Keep false on a server.
FRAPPER_ENABLE_DOCS=false

# App logs go to stdout → docker compose logs (rotated by the json-file driver).

FRAPPER_BOT_TOKEN=<..>

TG_FRAPPER_ID=<..>
TG_PHRASE_PL_ID=<..>
TG_PHRASE_EN_ID=<..>
TG_API_ID=<..>
TG_SU_ID=<..>
TG_API_HASH=<..>

SQLITE_DB_PATH=frapper.db
